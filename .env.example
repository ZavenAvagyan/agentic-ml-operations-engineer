# Agentic ML Operations Engineer — Runtime Configuration
# Copy this file to `.env` if you wish to customize local settings.
# NEVER commit `.env` or real API keys to version control.

# Runtime environment: "development" (default), "test", or "production"
# Note: "production" refuses to start if mock mode, dev key issuance, or test fixtures are enabled.
MLOPS_ENV=development

# Development API key issuance (must be false in production)
MLOPS_ENABLE_DEV_KEY_ISSUANCE=true

# Deterministic test-only fixture credentials (must be false outside automated pytest runs)
MLOPS_ENABLE_TEST_FIXTURES=false

# Telemetry connector mode: "mock" (default local SQLite adapters)
MLOPS_CONNECTOR_MODE=mock

# Outbound network guard when running in mock mode
MLOPS_BLOCK_OUTBOUND_IN_MOCK=true

# Provider mode: "auto" (uses Gemini if key is set, else "mock"), "mock", or "gemini"
MLOPS_PROVIDER_MODE=auto

# Optional: Google Gemini API Key (leave blank for deterministic Mock Mode)
GEMINI_API_KEY=

# Optional: Model identifier when using Gemini API provider
GEMINI_MODEL=gemini-2.5-flash

# Database path for local SQLite sandbox
MLOPS_DB_PATH=data/mlops_sandbox.db

# Safety, execution & per-tenant rate/resource limits
MLOPS_MAX_TOOL_CALLS_PER_INVESTIGATION=12
MLOPS_TOOL_TIMEOUT_SECONDS=5.0
MLOPS_MAX_RETRIES=2
MLOPS_MAX_INPUT_CHARS=4000
MLOPS_MAX_REQUEST_BODY_BYTES=32768
MLOPS_MAX_REQUESTS_PER_TENANT_PER_MINUTE=120
MLOPS_MAX_ANALYSES_PER_TENANT=50
